(rule
 (target prelude_source.ml)
 (deps
  Basics.elm
  packages/browser/Browser.elm
  packages/browser/Browser.Dom.elm
  Char.elm
  Dict.elm
  packages/html/Html.elm
  packages/html/Html.Attributes.elm
  packages/html/Html.Events.elm
  packages/html/Html.Keyed.elm
  packages/html/Html.Lazy.elm
  packages/json/Json.Decode.elm
