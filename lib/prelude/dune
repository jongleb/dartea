  Platform.elm
  Platform.Cmd.elm
  Platform.Sub.elm
  Result.elm
  String.elm
  Task.elm
  Tuple.elm
  packages/virtual-dom/VirtualDom.elm)
 (action
  (with-stdout-to
   prelude_source.ml
   (progn
    (echo "let basics = {elm|")
    (cat Basics.elm)
    (echo "|elm}\n\nlet browser = {elm|")
    (cat packages/browser/Browser.elm)
    (echo "|elm}\n\nlet char = {elm|")
    (cat Char.elm)
    (echo "|elm}\n\nlet dict = {elm|")
    (cat Dict.elm)
    (echo "|elm}\n\nlet html = {elm|")
    (cat packages/html/Html.elm)
    (echo "|elm}\n\nlet html_attributes = {elm|")
    (cat packages/html/Html.Attributes.elm)
    (echo "|elm}\n\nlet html_events = {elm|")
    (cat packages/html/Html.Events.elm)
    (echo "|elm}\n\nlet html_keyed = {elm|")
    (cat packages/html/Html.Keyed.elm)
    (echo "|elm}\n\nlet html_lazy = {elm|")
    (cat packages/html/Html.Lazy.elm)
    (echo "|elm}\n\nlet json_decode = {elm|")
    (cat packages/json/Json.Decode.elm)
    (echo "|elm}\n\nlet json_encode = {elm|")
    (cat packages/json/Json.Encode.elm)
    (echo "|elm}\n\nlet list = {elm|")
    (cat List.elm)
    (echo "|elm}\n\nlet maybe = {elm|")
    (cat Maybe.elm)
    (echo "|elm}\n\nlet platform = {elm|")
    (cat Platform.elm)
    (echo "|elm}\n\nlet platform_cmd = {elm|")
    (cat Platform.Cmd.elm)
    (echo "|elm}\n\nlet platform_sub = {elm|")
    (cat Platform.Sub.elm)
    (echo "|elm}\n\nlet result = {elm|")
    (cat Result.elm)
    (echo "|elm}\n\nlet string = {elm|")
    (cat String.elm)
    (echo "|elm}\n\nlet task = {elm|")
    (cat Task.elm)
    (echo "|elm}\n\nlet browser_dom = {elm|")
    (cat packages/browser/Browser.Dom.elm)
    (echo "|elm}\n\nlet tuple = {elm|")
    (cat Tuple.elm)
    (echo "|elm}\n\nlet virtual_dom = {elm|")
    (cat packages/virtual-dom/VirtualDom.elm)
    (echo "|elm}\n")))))

(library
 (name prelude)
 (libraries canonical)
 (preprocess
  (pps ppx_jane)))
